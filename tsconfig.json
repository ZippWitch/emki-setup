{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "types": ["node"],
        "paths": {
            "#utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}